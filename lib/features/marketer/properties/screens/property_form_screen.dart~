/// Add-property and edit-property share this one form. In add mode it
/// uploads the photos to Storage and creates the listing through the
/// backend; with [existingId] the fields are pre-filled from the marketer's
/// loaded listings and saving updates it (a delete option is shown).
class PropertyFormScreen extends StatefulWidget {
  final String? existingId;

  const PropertyFormScreen({super.key, this.existingId});

  @override
  State<PropertyFormScreen> createState() => _PropertyFormScreenState();
}

class _PropertyFormScreenState extends State<PropertyFormScreen> {
  final _formKey = GlobalKey<FormState>();
  late final TextEditingController _titleController;
  late final TextEditingController _areaController;
  late final TextEditingController _priceController;
  late final TextEditingController _leaseController;
  late final TextEditingController _roomsController;
  late final TextEditingController _bathsController;
  late final TextEditingController _descriptionController;
  late String _selectedType;
  String _listingType = 'sale';
  int? _cityId;
  int? _districtId;
  String? _cityError;
  List<String> _imagePaths = [];
  List<String> _originalUrls = [];
  bool _submitting = false;

  bool get _isEditMode => widget.existingId != null;

  @override
  void initState() {
    super.initState();
    final l = widget.existingId == null
        ? null
        : context.read<MyListingsCubit>().state.items.where((e) => e.id == widget.existingId).firstOrNull;
    String num(double? v) => v == null ? '' : (v == v.roundToDouble() ? v.toInt().toString() : v.toString());
    _titleController = TextEditingController(text: l?.title ?? '');
    _areaController = TextEditingController(text: num(l?.area));
    _priceController = TextEditingController(text: num(l == null ? null : (l.isRent ? (l.rentMonthly ?? l.rentDaily) : l.price)));
    _leaseController = TextEditingController(text: l?.leaseDurationMonths?.toString() ?? '');
    _roomsController = TextEditingController(text: l?.rooms?.toString() ?? '');
    _bathsController = TextEditingController(text: l?.bathrooms?.toString() ?? '');
    _descriptionController = TextEditingController(text: l?.description ?? '');
    _selectedType = l?.propertyType ?? propertyTypeOptions.first;
    _listingType = l?.listingType ?? 'sale';
    _cityId = l?.cityId;
    _districtId = l?.districtId;
    _imagePaths = [if (l != null) ...(l.images.isNotEmpty ? l.images : [if (l.coverImageUrl != null) l.coverImageUrl!])];
    _originalUrls = List.of(_imagePaths);
    // The list rows carry only the cover; fetch the full photo set for editing.
    if (l != null) _loadDetails(l.id);
  }

  Future<void> _loadDetails(String id) async {
    try {
      final full = await context.read<MyListingsCubit>().listingsRepository.details(id);
      if (!mounted) return;
      setState(() {
        if (full.images.isNotEmpty) {
          _imagePaths = List.of(full.images);
          _originalUrls = List.of(full.images);
        }
        if (_descriptionController.text.isEmpty) _descriptionController.text = full.description ?? '';
      });
    } on ApiException {
      // keep what we have
    }
  }

  @override
  void dispose() {
    _titleController.dispose();
    _areaController.dispose();
    _priceController.dispose();
    _leaseController.dispose();
    _roomsController.dispose();
    _bathsController.dispose();
    _descriptionController.dispose();
    super.dispose();
  }

  Future<void> _pickImages() async {
    // Gallery only — picking from the camera needs an extra Android
    // manifest permission this project doesn't declare yet.
    final picked = await ImagePicker().pickMultiImage(imageQuality: 80);
    if (picked.isNotEmpty) {
      setState(() => _imagePaths.addAll(picked.map((x) => x.path)));
    }
  }

  /// Adds a photo by pasting its link instead of picking a file.
  Future<void> _addImageByLink() async {
    final controller = TextEditingController();
    final link = await showDialog<String>(
      context: context,
      builder: (dialogContext) {
        String? error;
        return StatefulBuilder(
          builder: (context, setLocal) => AlertDialog(
            shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(14)),
            title: Text(LocaleKeys.propertyAddImageLink.tr(), style: AppTextStyles.heading4),
            content: TextField(
              controller: controller,
              keyboardType: TextInputType.url,
              autofocus: true,
              // textDirection: TextDirection.LTR,
              decoration: InputDecoration(hintText: LocaleKeys.propertyImageLinkHint.tr(), errorText: error, errorMaxLines: 2),
            ),
            actions: [
              TextButton(onPressed: () => Navigator.of(dialogContext).pop(), child: Text(LocaleKeys.cancelButton.tr())),
              TextButton(
                onPressed: () {
                  final v = controller.text.trim();
                  final uri = Uri.tryParse(v);
                  if (uri == null || !(uri.scheme == 'http' || uri.scheme == 'https') || uri.host.isEmpty) {
                    setLocal(() => error = LocaleKeys.propertyImageLinkInvalid.tr());
                    return;
                  }
                  Navigator.of(dialogContext).pop(v);
                },
                child: Text(LocaleKeys.okButton.tr()),
              ),
            ],
          ),
        );
      },
    );
    controller.dispose();
    if (link != null && !_imagePaths.contains(link)) setState(() => _imagePaths.add(link));
  }

  void _removeImageAt(int index) {
    setState(() => _imagePaths.removeAt(index));
  }

  double? _num(TextEditingController c) => double.tryParse(c.text.trim().replaceAll(',', ''));
  int? _int(TextEditingController c) => int.tryParse(c.text.trim());

  void _snack(String message) => ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(message)));

  Future<void> _submit() async {
    final valid = _formKey.currentState!.validate();
    setState(() => _cityError = _cityId == null ? LocaleKeys.propertyCityRequired.tr() : null);
    if (!valid || _cityId == null) return;

    setState(() => _submitting = true);
    final cubit = context.read<MyListingsCubit>();
    final isRent = _listingType == 'rent';
    final price = _num(_priceController);

    // 1) photos -> Storage (already-uploaded URLs are kept)
    List<String> urls;
    try {
      urls = await StorageService().uploadAll(
        StorageService.propertyImages,
        widget.existingId ?? 'new-${DateTime.now().millisecondsSinceEpoch}',
        _imagePaths,
      );
    } on ApiException catch (e) {
      if (!mounted) return;
      setState(() => _submitting = false);
      _snack(e.status == null ? e.text : LocaleKeys.propertyUploadFailed.tr());
      return;
    }

    // 2) the listing itself
    bool ok;
    if (_isEditMode) {
      ok = await cubit.update(widget.existingId!, {
        'title': _titleController.text.trim(),
        'property_type': _selectedType,
        'listing_type': _listingType,
        'city_id': _cityId,
        'district_id': _districtId,
        'area': _num(_areaController),
        'rooms': _int(_roomsController),
        'bathrooms': _int(_bathsController),
        'description': _descriptionController.text.trim(),
        if (isRent) 'rent_monthly': price else 'price': price,
        if (isRent) 'lease_duration_months': _int(_leaseController),
      });
      if (ok) {
        final newUrls = [for (final u in urls) if (!_originalUrls.contains(u)) u];
        if (newUrls.isNotEmpty) await cubit.addImages(widget.existingId!, newUrls);
      }
    } else {
      ok = await cubit.create(ListingInput(
        title: _titleController.text.trim(),
        listingType: _listingType,
        propertyType: _selectedType,
        cityId: _cityId,
        districtId: _districtId,
        area: _num(_areaController),
        rooms: _int(_roomsController),
        bathrooms: _int(_bathsController),
        price: isRent ? null : price,
        rentMonthly: isRent ? price : null,
        leaseDurationMonths: isRent ? _int(_leaseController) : null,
        description: _descriptionController.text.trim().isEmpty ? null : _descriptionController.text.trim(),
        images: urls,
      ));
    }
    if (!mounted) return;
    setState(() => _submitting = false);
    if (!ok) {
      _snack(cubit.state.error?.text ?? LocaleKeys.apiErrGeneric.tr());
      return;
    }
    cubit.load(); // refresh covers / counts

    await showDialog<void>(
      context: context,
      builder: (dialogContext) => AlertDialog(
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(14)),
        title: Row(
          mainAxisSize: MainAxisSize.min,
          children: [
            const Icon(Icons.check_circle, color: AppColors.primary),
            const SizedBox(width: 8),
            Text(LocaleKeys.propertySavedSuccessTitle.tr(), style: AppTextStyles.heading4),
          ],
        ),
        content: Text(
          (_isEditMode ? LocaleKeys.propertyUpdatedSuccessDesc : LocaleKeys.propertyAddedSuccessDesc).tr(),
          style: AppTextStyles.bodyRegular,
          textAlign: TextAlign.start,
        ),
        actions: [
          TextButton(onPressed: () => Navigator.of(dialogContext).pop(), child: Text(LocaleKeys.okButton.tr())),
        ],
      ),
    );
    if (!mounted) return;
    Navigator.of(context).pop();
  }

  Future<void> _confirmDelete() async {
    final confirmed = await showDialog<bool>(
      context: context,
      builder: (dialogContext) => AlertDialog(
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(14)),
        title: Text(LocaleKeys.deletePropertyConfirmTitle.tr(), style: AppTextStyles.heading4),
        content: Text(LocaleKeys.deletePropertyConfirmDesc.tr(), style: AppTextStyles.bodyRegular, textAlign: TextAlign.start),
        actions: [
          TextButton(onPressed: () => Navigator.of(dialogContext).pop(false), child: Text(LocaleKeys.cancelButton.tr())),
          TextButton(
            onPressed: () => Navigator.of(dialogContext).pop(true),
            child: Text(LocaleKeys.deletePropertyButton.tr(), style: const TextStyle(color: AppColors.error)),
          ),
        ],
      ),
    );
    if (confirmed == true) {
      final id = widget.existingId;
      if (id == null) return;
      final cubit = context.read<MyListingsCubit>();
      final ok = await cubit.delete(id);
      if (!mounted) return;
      if (ok) {
        Navigator.of(context).pop();
      } else {
        _snack(cubit.state.error?.text ?? LocaleKeys.apiErrGeneric.tr());
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: AppColors.background,
      appBar: AppBar(
        title: Text((_isEditMode ? LocaleKeys.editPropertyTitle : LocaleKeys.addPropertyTitle).tr(), style: AppTextStyles.heading3),
        leading: const AppBackButton(),
      ),
      body: SafeArea(
        child: Form(
          key: _formKey,
          child: ListView(
            padding: const EdgeInsets.fromLTRB(16, 16, 16, 24),
            children: [
              MultiImagePickerField(
                imagePaths: _imagePaths,
                onAdd: _pickImages,
                onRemove: _removeImageAt,
                label: LocaleKeys.propertyPhotoLabel.tr(),
              ),
              Align(
                alignment: AlignmentDirectional.centerEnd,
                child: TextButton.icon(
                  onPressed: _addImageByLink,
                  icon: const Icon(Icons.link, size: 18),
                  label: Text(LocaleKeys.propertyAddImageLink.tr()),
                ),
              ),
              const SizedBox(height: 20),
              ValidatedTextField(controller: _titleController, label: LocaleKeys.offerPropertyTitleLabel.tr()),
              const SizedBox(height: 16),
              PropertyTypeChips(selected: _selectedType, onChanged: (type) => setState(() => _selectedType = type)),
              const SizedBox(height: 16),
              _ListingTypeChips(value: _listingType, onChanged: (v) => setState(() => _listingType = v)),
              const SizedBox(height: 16),
              _LocationPickers(
                cityId: _cityId,
                districtId: _districtId,
                cityError: _cityError,
                onCity: (v) => setState(() {
                  _cityId = v;
                  _districtId = null;
                  _cityError = null;
                }),
                onDistrict: (v) => setState(() => _districtId = v),
              ),
              const SizedBox(height: 16),
              Row(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Expanded(
                    child: ValidatedTextField(controller: _areaController, label: LocaleKeys.specArea.tr(), keyboardType: TextInputType.number),
                  ),
                  const SizedBox(width: 16),
                  Expanded(
                    child: ValidatedTextField(
                      controller: _priceController,
                      label: (_listingType == 'rent' ? LocaleKeys.propertyRentMonthlyLabel : LocaleKeys.propertyPriceLabel).tr(),
                      keyboardType: TextInputType.number,
                    ),
                  ),
                ],
              ),
              if (_listingType == 'rent') ...[
                const SizedBox(height: 16),
                ValidatedTextField(controller: _leaseController, label: LocaleKeys.propertyLeaseMonthsLabel.tr(), keyboardType: TextInputType.number),
              ],
              const SizedBox(height: 16),
              Row(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Expanded(
                    child: ValidatedTextField(controller: _roomsController, label: LocaleKeys.specRooms.tr(), keyboardType: TextInputType.number, required: false),
                  ),
                  const SizedBox(width: 16),
                  Expanded(
                    child: ValidatedTextField(controller: _bathsController, label: LocaleKeys.specBathrooms.tr(), keyboardType: TextInputType.number, required: false),
                  ),
                ],
              ),
              const SizedBox(height: 16),
              ValidatedTextField(
                controller: _descriptionController,
                label: LocaleKeys.propertyDescriptionLabel.tr(),
                maxLines: 4,
                required: false,
              ),
              const SizedBox(height: 28),
              AppPrimaryButton(
                label: (_isEditMode ? LocaleKeys.savePropertyButton : LocaleKeys.addPropertySubmit).tr(),
                icon: Icons.check,
                isLoading: _submitting,
                onPressed: _submitting ? null : _submit,
              ),
              if (_isEditMode) ...[
                const SizedBox(height: 12),
                OutlinedButton.icon(
                  onPressed: _confirmDelete,
                  icon: const Icon(Icons.delete_outline, size: 18),
                  label: Text(LocaleKeys.deletePropertyButton.tr()),
                  style: OutlinedButton.styleFrom(
                    foregroundColor: AppColors.error,
                    side: const BorderSide(color: AppColors.error),
                    minimumSize: const Size.fromHeight(48),
                    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
                  ),
                ),
              ],
            ],
          ),
        ),
      ),
    );
  }
}


class _ListingTypeChips extends StatelessWidget {
  final String value;
  final ValueChanged<String> onChanged;
  const _ListingTypeChips({required this.value, required this.onChanged});

  @override
  Widget build(BuildContext context) {
    Widget chip(String v, String label) {
      final selected = value == v;
      return ChoiceChip(
        label: Text(label),
        selected: selected,
        onSelected: (_) => onChanged(v),
        selectedColor: AppColors.primary,
        backgroundColor: AppColors.surface,
        labelStyle: AppTextStyles.bodySmall.copyWith(color: selected ? Colors.white : AppColors.textPrimary),
        side: BorderSide(color: selected ? AppColors.primary : AppColors.border),
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(999)),
        showCheckmark: false,
      );
    }

    return Wrap(
      alignment: WrapAlignment.end,
      spacing: 8,
      children: [
        chip('sale', LocaleKeys.listingForSale.tr()),
        chip('rent', LocaleKeys.listingForRent.tr()),
      ],
    );
  }
}

class _LocationPickers extends StatelessWidget {
  final int? cityId;
  final int? districtId;
  final String? cityError;
  final ValueChanged<int?> onCity;
  final ValueChanged<int?> onDistrict;
  const _LocationPickers({
    required this.cityId,
    required this.districtId,
    required this.cityError,
    required this.onCity,
    required this.onDistrict,
  });

  @override
  Widget build(BuildContext context) {
    final lang = context.locale.languageCode;
    final districts = cityId == null ? const <District>[] : Locations.districtsOf(cityId!);
    InputDecoration deco(String hint, {String? error}) => InputDecoration(
          hintText: hint,
          errorText: error,
          filled: true,
          fillColor: AppColors.surface,
          border: OutlineInputBorder(borderRadius: BorderRadius.circular(8), borderSide: const BorderSide(color: AppColors.border)),
          enabledBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(8), borderSide: const BorderSide(color: AppColors.border)),
        );
    return Column(
      crossAxisAlignment: CrossAxisAlignment.end,
      children: [
        Text(LocaleKeys.cityLabel.tr(), style: AppTextStyles.bodySmall),
        const SizedBox(height: 6),
        DropdownButtonFormField<int>(
          value: cityId,
          isExpanded: true,
          decoration: deco(LocaleKeys.cityPlaceholder.tr(), error: cityError),
          items: [for (final c in Locations.cities) DropdownMenuItem(value: c.id, child: Text(c.name(lang)))],
          onChanged: onCity,
        ),
        const SizedBox(height: 16),
        Text(LocaleKeys.districtLabel.tr(), style: AppTextStyles.bodySmall),
        const SizedBox(height: 6),
        DropdownButtonFormField<int>(
          key: ValueKey('district-$cityId'),
          value: districtId,
          isExpanded: true,
          decoration: deco(LocaleKeys.districtPlaceholder.tr()),
          items: [for (final d in districts) DropdownMenuItem(value: d.id, child: Text(d.name(lang)))],
          onChanged: cityId == null ? null : onDistrict,
        ),
      ],
    );
  }
}
