import 'package:flutter/material.dart';
import 'package:easy_localization/easy_localization.dart';
import '../../../../config/router/app_router.dart';
import '../../../../core/shared/widgets/customer/categories_row.dart';
import '../../../../core/shared/widgets/customer/section_header.dart';
import '../../../../core/shared/widgets/fields/search_bar.dart';
import '../../../../core/shared/widgets/top_bar.dart';
import '../../../../core/shared/widgets/buttons/app_primary_button.dart';
import '../models/property_request.dart';
import '../widgets/request_card.dart';
import '../../../../generated/locale_keys.g.dart';

/// Content for the "Home" tab only — no Scaffold/bottom nav here.
/// [ClientShellScreen] owns those and swaps this in via BottomBarCubit.
class HomeScreen extends StatelessWidget {
  const HomeScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return SafeArea(
      child: ListView(
        padding: const EdgeInsets.fromLTRB(16, 16, 16, 24),
        children: [
          TopBar(),
          const SizedBox(height: 24),
          CustomSearchBar(
              onTap: () => Navigator.pushNamed(context, AppRoutes.search,)
          ,searchText: LocaleKeys.searchPlaceholder.tr(),),
          const SizedBox(height: 24),
          CategoriesRow(
            onCategoryTap: (category) => Navigator.pushNamed(context, AppRoutes.search, arguments: category),
          ),
          const SizedBox(height: 24),
          SectionHeader(onViewAllTap: () => Navigator.pushNamed(context, AppRoutes.search),),
          const SizedBox(height: 16),
          ...mockRecentRequests.map(
            (r) => Padding(
              padding: const EdgeInsets.only(bottom: 16),
              child: RequestCard(
                request: r,
                onTap: () => Navigator.pushNamed(context, AppRoutes.requestDetails, arguments: r.id),
              ),
            ),
          ),
          const SizedBox(height: 8),
          AppPrimaryButton(
            label: LocaleKeys.createRequestButton.tr(),
            icon: Icons.add,
            onPressed: () => Navigator.pushNamed(context, AppRoutes.createRequestLocation),
          ),
        ],
      ),
    );
  }
}




